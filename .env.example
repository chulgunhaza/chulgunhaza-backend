# 이 프로젝트를 처음 받았을 때 .env로 복사해서 값을 채워 넣으세요.
#   cp .env.example .env
#
# .env 자체는 .gitignore에 있어서 커밋되지 않습니다 — 실제 값은 각자 로컬/배포
# 환경에 맞게 채우면 됩니다. 아래는 로컬 개발 기준 예시 값입니다.

# --- RabbitMQ (compose.yaml의 rabbitmq 컨테이너 계정) ---
# Spring 쪽은 spring.rabbitmq.username/password를 따로 안 정해뒀으면 기본값
# "guest"/"guest"를 쓰므로, 아래 값도 guest로 맞춰두면 별도 설정 없이 붙습니다.
RMQ_USER=guest
RMQ_PASS=guest

# --- Redis (세션 스토어) ---
REDIS_PASS=changeme-redis-password
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PASS=changeme-redis-password

# --- MySQL (compose.yaml에는 없음 — 직접 띄우거나 접속 가능한 MySQL을 준비) ---
# 로컬에서 docker로 띄운다면 포트를 3306이 아닌 다른 값(예: 3307)으로 매핑해서
# 로컬에 이미 떠 있는 MySQL과 충돌하지 않게 하는 걸 권장합니다.
DATABASE_URL="jdbc:mysql://localhost:3307/chulgunhaza?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul"
DATABASE_USER=chulgunhaza
DATABASE_PASSWORD=changeme-db-password

# --- 파일 업로드 저장 경로 (로컬 디스크, S3 마이그레이션 전) ---
UPLOAD_DIR=./uploads

# --- CORS 허용 origin (콤마로 여러 개 지정 가능) ---
# 지정 안 하면 기본값 http://localhost:3000(프론트 로컬 dev 서버)만 허용됩니다.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
