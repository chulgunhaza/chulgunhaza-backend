<?xml version="1.0" encoding="UTF-8"?>
<!-- #51: 로그 파일 롤링/보관 — 날짜가 바뀌거나 파일이 100MB를 넘으면 새 파일로
     넘어가고, 30일 지난 로그와 전체 용량이 3GB를 넘는 오래된 로그는 자동 삭제한다.
     별도 @Scheduled 정리 작업을 직접 만드는 대신 logback의 표준 롤링 정책에
     맡겼다 — 파일 삭제 타이밍을 직접 관리하는 코드를 새로 짜고 테스트할 필요가
     없어서 더 안전하다. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_DIR" value="${LOG_DIR:-./logs}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/chulgunhaza-backend.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/chulgunhaza-backend.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
