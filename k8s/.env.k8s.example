# VM 위에서만 쓰는 파일 — 로컬 개발용 .env(레포 루트)와는 다른 별도 파일이다.
# 로컬 .env는 전부 localhost 기준이지만, 여기는 k8s Service DNS명(mysql/redis/
# rabbitmq/user-server/attendance-server) 기준으로 채워야 한다.
#
# 사용법(VM 안, chulgunhaza-backend 레포 루트에서):
#   cp k8s/.env.k8s.example .env.k8s
#   vim .env.k8s   # 값 채우기 (<VM_IP>는 이 VM의 실제 IP로 치환)
#
# 이 파일은 vm-deploy.sh가 `kubectl create secret generic app-env
# --from-env-file=.env.k8s`로 통째로 k8s Secret에 넣는다 — 앱이 실제로
# 기대하는 이름 그대로라 별도 매핑 없이 envFrom: secretRef로 그대로 주입된다.
# git에는 올리지 않는다(.gitignore에 .env.k8s 추가해둠 — 이 .example 파일만 커밋).

# --- MySQL ---
DATABASE_URL=jdbc:mysql://mysql:3306/chulgunhaza_user?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
ATTENDANCE_DATABASE_URL=jdbc:mysql://mysql:3306/chulgunhaza_attendance?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
CHATTING_DATABASE_URL=jdbc:mysql://mysql:3306/chulgunhaza_chatting?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
DATABASE_USER=chulgunhaza
DATABASE_PASSWORD=changeme-db-password
MYSQL_ROOT_PASSWORD=changeme-root-password

# --- Redis (#98 refresh 토큰, #101 chat presence/fanout 공용) ---
SPRING_REDIS_HOST=redis
SPRING_REDIS_PASS=changeme-redis-password

# --- RabbitMQ ---
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# --- 파일 업로드 (PVC 없음 — 파드 재시작하면 사라지는 임시 경로) ---
UPLOAD_DIR=/app/uploads

# --- CORS: 포트포워딩 없이 VM IP로 직접 접근하므로 그 origin을 그대로 허용 ---
CORS_ALLOWED_ORIGINS=http://<VM_IP>:30080

# --- JWT (레포 루트 .env.example의 openssl 안내와 동일하게 생성) ---
JWT_PRIVATE_KEY=changeme-base64-encoded-pkcs8-private-key
JWT_PUBLIC_KEY=changeme-base64-encoded-x509-public-key

# --- 서비스 간 내부 API 호출: k8s Service DNS명 ---
ATTENDANCE_SERVER_INTERNAL_URL=http://attendance-server:8082
USER_SERVER_INTERNAL_URL=http://user-server:8081
